# PostgreSQL connection string (local dev).
# NOTE: password is a placeholder - update to match your local PostgreSQL.
# Copy this file to `.env` before running the server.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/amazon_clone"

# Secret used to sign/verify JWTs. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Backend port (defaults to 3001).
PORT=3001

# Allowed frontend origin for CORS.
CLIENT_ORIGIN=http://localhost:5173