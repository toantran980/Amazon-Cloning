# PostgreSQL connection string.
# Use a local instance or a hosted one (Railway, Supabase, Neon, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/amazon_clone"

# Secret used to sign/verify JWTs. Use a long, random string.
JWT_SECRET="replace-with-a-long-random-secret"

# Port the backend listens on (defaults to 3001).
# PORT=3001

# Allowed frontend origin for CORS (defaults to http://localhost:5173).
# CLIENT_ORIGIN=http://localhost:5173
