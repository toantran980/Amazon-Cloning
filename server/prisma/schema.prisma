generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  cart         CartItem[]
  orders       Order[]
}

model Product {
  id            String   @id
  image         String
  name          String
  ratingStars   Float
  ratingCount   Int
  priceCents    Int
  keywords      String[]
  type          String?
  sizeChartLink String?
}

model CartItem {
  id               String @id @default(cuid())
  userId           String
  productId        String
  quantity         Int
  deliveryOptionId String
  user             User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Order {
  id         String      @id
  userId     String
  orderDate  BigInt
  totalCents Int
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  products   OrderItem[]
}

model OrderItem {
  id                    String @id @default(cuid())
  orderId               String
  productId             String
  quantity              Int
  deliveryOptionId      String
  estimatedDeliveryDate String
  status                String @default("preparing")
  order                 Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}
